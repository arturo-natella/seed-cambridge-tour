{
  "name": "seed-cambridge-tour",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "start": "serve -l tcp://127.0.0.1:4173 . --no-clipboard",
    "build:model": "node scripts/build-model.mjs",
    "test": "node tests/tour.mjs && node tests/carousel-layout.mjs && node tests/model-energy.mjs && node tests/thermal-design.mjs && node tests/fans.mjs",
    "test:clarity": "node scripts/check-rendering-clarity.mjs",
    "stills": "node scripts/render-stills.mjs",
    "import:content": "python3 -I scripts/import-content.py"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "serve": "14.2.5",
    "gltf-validator": "2.0.0-dev.3.10"
  }
}
